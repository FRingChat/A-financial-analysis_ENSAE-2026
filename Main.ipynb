    "import pandas as pd\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "\n",
    "# Import du module fonctions.py\n",
    "import fonctions\n",
    "\n",
    "# Configuration de l'affichage\n",
    "pd.set_option('display.max_columns', 15)\n",
    "pd.set_option('display.precision', 3)\n",
    "sns.set_theme(style=\"whitegrid\")\n",
    "\n",
    "# Période étudiée dans tout le notebook : résultats publiés à partir de cette date (voir ci-dessus)\n",
    "DATE_DEBUT_ECHANTILLON = '2010-01-01'\n",
    "print(\"Importations réalisées avec succès !\")"
   ]
