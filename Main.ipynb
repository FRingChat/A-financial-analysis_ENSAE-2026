    "# Extraction du BPA trimestriel, ajusté des divisions d'actions (base actuelle, comme Alpha Vantage)\n",
    "# et complété des T4 que le 10-K ne publie pas (T4 = BPA annuel - T1 - T2 - T3)\n",
    "df_sec_eps = fonctions.build_quarterly_eps(\n",
    "    facts=facts,\n",
    "    symbol=\"AAPL\",\n",
    "    metric_name='EarningsPerShareDiluted'\n",
    ")\n",
    "\n",
    "# Restriction à la période étudiée : trimestres clos au plus 3 mois avant DATE_DEBUT_ECHANTILLON\n",
    "# (publiés 2 à 5 semaines après leur clôture, donc à partir de DATE_DEBUT_ECHANTILLON)\n",
    "debut_trimestres = pd.Timestamp(DATE_DEBUT_ECHANTILLON) - pd.DateOffset(months=3)\n",
    "df_sec_eps = df_sec_eps[df_sec_eps['end'] >= debut_trimestres].reset_index(drop=True)\n",
    "\n",
    "print(f\"Nombre de trimestres SEC retenus : {len(df_sec_eps)} (dont {df_sec_eps['q4_derive'].sum()} T4 reconstitués), \"\n",
    "      f\"clos du {df_sec_eps['end'].min():%d/%m/%Y} au {df_sec_eps['end'].max():%d/%m/%Y}\")\n",
    "print(\"\\n--- Aperçu des dernières déclarations trimestrielles ---\")\n",
    "display(df_sec_eps[['end', 'val', 'val_brut', 'facteur_split', 'fp', 'form', 'q4_derive']].tail(5))\n",
    "\n",
    "print(\"\\n--- Vérification des cellules vides ---\")\n",
    "print(df_sec_eps.drop(columns=['val_brut', 'frame']).isnull().sum())  # val_brut/frame vides pour les T4 reconstitués"
   ]
